# Corebanking backend integration.
# Leave VITE_API_BASE_URL unset to run entirely on in-memory mock fixtures.
# Set it to a running corebanking-starter instance to use the live API
# (see postman/corebanking-starter.postman_collection.json).

# VITE_API_BASE_URL=http://localhost:8084
# VITE_API_USER=admin
# VITE_API_PASSWORD=admin
# Force mock even when a base URL is set:
# VITE_API_MOCK=true
